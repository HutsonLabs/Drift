<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- HOST-13: one per logged-in user. Captures, encodes and injects in that user's session for the
     connections the daemon hands it. Registered with SMAppService.agent(plistName:). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hutsonlabs.drift.host.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/drift-host</string>
	<key>ProgramArguments</key>
	<array>
		<string>drift-host</string>
		<string>agent</string>
		<string>aqua</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.hutsonlabs.drift.host</string>
	</array>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
